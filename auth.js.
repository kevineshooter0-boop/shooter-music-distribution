"use strict";

(() => {
  const SUPABASE_URL = https://ubsdezmxzoztvzplngie.supabase.co;
  const SUPABASE_KEY = sb_publishable_2sFK3LP1d5bh0C4GqbXktA_7RsPi0u_;

  if (!window.supabase) {
    throw new Error("La bibliothèque Supabase n'a pas été chargée.");
  }

  if (
    SUPABASE_URL === https://ubsdezmxzoztvzplngie.supabase.co||
    SUPABASE_KEY === sb_publishable_2sFK3LP1d5bh0C4GqbXktA_7RsPi0u_
  ) {
    throw new Error("Configure l'URL et la clé publique de Supabase dans auth.js.");
  }

  const client = window.supabase.createClient(
    SUPABASE_URL,
    SUPABASE_KEY
  );

  // INSCRIPTION D'UN ARTISTE
  async function inscrireArtiste(email, password, artistName) {
    const nom = artistName.trim();
    const adresse = email.trim();

    if (!nom || !adresse || password.length < 8) {
      throw new Error(
        "Vérifie les champs. Le nom et l'e-mail sont obligatoires, et le mot de passe doit contenir au moins 8 caractères."
      );
    }

    const { data, error } = await client.auth.signUp({
      email: adresse,
      password,
      options: {
        data: {
          artist_name: nom
        }
      }
    });

    if (error) throw error;

    // Supabase peut exiger une confirmation par e-mail.
    // Dans ce cas, le profil sera créé lors de la première connexion.
    if (data.user && data.session) {
      await obtenirOuCreerProfil(data.user);
    }

    return data;
  }

  // CONNEXION
  async function connecterArtiste(email, password) {
    const { data, error } = await client.auth.signInWithPassword({
      email: email.trim(),
      password
    });

    if (error) throw error;

    if (data.user) {
      await obtenirOuCreerProfil(data.user);
    }

    return data;
  }

  // OBTENIR OU CRÉER LE PROFIL
  async function obtenirOuCreerProfil(user) {
    const { data: profil, error: lectureErreur } = await client
      .from("artists")
      .select("id, artist_name, country, created_at")
      .eq("id", user.id)
      .maybeSingle();

    if (lectureErreur) throw lectureErreur;

    if (profil) return profil;

    const nom =
      user.user_metadata?.artist_name ||
      user.email?.split("@")[0] ||
      "Artiste";

    const { data: nouveauProfil, error: creationErreur } = await client
      .from("artists")
      .insert({
        id: user.id,
        artist_name: nom,
        country: null
      })
      .select("id, artist_name, country, created_at")
      .single();

    if (creationErreur) throw creationErreur;

    return nouveauProfil;
  }

  // SESSION
  async function obtenirSession() {
    const { data, error } = await client.auth.getSession();

    if (error) throw error;

    return data.session;
  }

  // PROFIL DE L'ARTISTE CONNECTÉ
  async function obtenirProfilArtiste(user) {
    if (!user) {
      throw new Error("Connecte-toi pour accéder à ton profil.");
    }

    return await obtenirOuCreerProfil(user);
  }

  // ENREGISTRER UN PROJET MUSICAL
  async function creerSortie(title, releaseType) {
    const session = await obtenirSession();

    if (!session) {
      throw new Error("Ta session a expiré. Connecte-toi à nouveau.");
    }

    const titre = title.trim();
    const typesAutorises = ["single", "ep", "album"];

    if (!titre || titre.length > 200) {
      throw new Error("Le titre est obligatoire et ne doit pas dépasser 200 caractères.");
    }

    if (!typesAutorises.includes(releaseType)) {
      throw new Error("Le type de sortie sélectionné n'est pas valide.");
    }

    const { data, error } = await client
      .from("music_releases")
      .insert({
        artist_id: session.user.id,
        title: titre,
        release_type: releaseType,
        status: "draft"
      })
      .select("id, title, release_type, status, created_at")
      .single();

    if (error) throw error;

    return data;
  }

  // LISTER LES PROJETS DE L'ARTISTE CONNECTÉ
  async function obtenirSorties() {
    const session = await obtenirSession();

    if (!session) {
      throw new Error("Connecte-toi pour consulter tes projets.");
    }

    const { data, error } = await client
      .from("music_releases")
      .select("id, title, release_type, status, created_at")
      .eq("artist_id", session.user.id)
      .order("created_at", { ascending: false });

    if (error) throw error;

    return data || [];
  }

  // DÉCONNEXION
  async function deconnecterArtiste() {
    const { error } = await client.auth.signOut();

    if (error) throw error;
  }

  // Fonctions utilisées par index.html
  window.inscrireArtiste = inscrireArtiste;
  window.connecterArtiste = connecterArtiste;
  window.obtenirSession = obtenirSession;
  window.obtenirProfilArtiste = obtenirProfilArtiste;
  window.creerSortie = creerSortie;
  window.obtenirSorties = obtenirSorties;
  window.deconnecterArtiste = deconnecterArtiste;

  // Pour vérification et développement uniquement.
  // La clé exposée ici est la clé publique, jamais la service_role.
  window.shooterSupabase = client;
})();
