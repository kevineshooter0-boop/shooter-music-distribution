"use strict";

import {
  auth,
  db,
  createUserWithEmailAndPassword,
  signInWithEmailAndPassword,
  sendEmailVerification,
  sendPasswordResetEmail,
  signOut,
  onAuthStateChanged
} from "./firebase.js";

import {
  doc,
  getDoc,
  setDoc,
  collection,
  addDoc,
  getDocs,
  query,
  where,
  orderBy
} from "https://www.gstatic.com/firebasejs/13.3.0/firebase-firestore.js";

// INSCRIPTION D'UN ARTISTE
async function inscrireArtiste(email, password, artistName) {
  const nom = artistName.trim();
  const adresse = email.trim();

  if (!nom || !adresse || password.length < 8) {
    throw new Error("Le nom et l'e-mail sont obligatoires. Le mot de passe doit contenir au moins 8 caractères.");
  }

  const result = await createUserWithEmailAndPassword(auth, adresse, password);

  await sendEmailVerification(result.user);

  await setDoc(doc(db, "users", result.user.uid), {
    artist_name: nom,
    email: adresse,
    country: null,
    role: "artist",
    created_at: new Date().toISOString()
  });

  return result;
}

// CONNEXION
async function connecterArtiste(email, password) {
  const result = await signInWithEmailAndPassword(
    auth,
    email.trim(),
    password
  );

  await obtenirOuCreerProfil(result.user);

  return result;
}

// PROFIL ARTISTE
async function obtenirOuCreerProfil(user) {
  if (!user) {
    throw new Error("Connecte-toi pour accéder à ton profil.");
  }

  const profilRef = doc(db, "users", user.uid);
  const profilSnap = await getDoc(profilRef);

  if (profilSnap.exists()) {
    return profilSnap.data();
  }

  const profil = {
    artist_name: user.displayName || user.email.split("@")[0],
    email: user.email,
    country: null,
    role: "artist",
    created_at: new Date().toISOString()
  };

  await setDoc(profilRef, profil);

  return profil;
}

// SESSION
async function obtenirSession() {
  return new Promise((resolve) => {
    const unsubscribe = onAuthStateChanged(auth, (user) => {
      unsubscribe();
      resolve(user);
    });
  });
}

// PROFIL CONNECTÉ
async function obtenirProfilArtiste(user) {
  if (!user) {
    throw new Error("Connecte-toi pour accéder à ton profil.");
  }

  return obtenirOuCreerProfil(user);
}

// CRÉER UNE SORTIE MUSICALE
async function creerSortie(title, releaseType) {
  const user = await obtenirSession();

  if (!user) {
    throw new Error("Connecte-toi pour continuer.");
  }

  if (!user.emailVerified) {
    throw new Error("Vérifie ton adresse e-mail avant de créer une sortie musicale.");
  }

  const titre = title.trim();
  const typesAutorises = ["single", "ep", "album"];

  if (!titre || titre.length > 200) {
    throw new Error("Le titre est obligatoire et ne doit pas dépasser 200 caractères.");
  }

  if (!typesAutorises.includes(releaseType)) {
    throw new Error("Type de sortie invalide.");
  }

  const resultat = await addDoc(collection(db, "releases"), {
    artist_id: user.uid,
    title: titre,
    release_type: releaseType,
    status: "draft",
    created_at: new Date().toISOString()
  });

  return {
    id: resultat.id,
    title: titre,
    release_type: releaseType,
    status: "draft"
  };
}

// LISTER LES SORTIES
async function obtenirSorties() {
  const user = await obtenirSession();

  if (!user) {
    throw new Error("Connecte-toi pour consulter tes projets.");
  }

  const q = query(
    collection(db, "releases"),
    where("artist_id", "==", user.uid),
    orderBy("created_at", "desc")
  );

  const resultat = await getDocs(q);

  return resultat.docs.map((document) => ({
    id: document.id,
    ...document.data()
  }));
}

// RÉINITIALISATION DU MOT DE PASSE
async function reinitialiserMotDePasse(email) {
  await sendPasswordResetEmail(auth, email.trim());
}

// DÉCONNEXION
async function deconnecterArtiste() {
  await signOut(auth);
}

// FONCTIONS ACCESSIBLES DEPUIS LE SITE
window.inscrireArtiste = inscrireArtiste;
window.connecterArtiste = connecterArtiste;
window.obtenirSession = obtenirSession;
window.obtenirProfilArtiste = obtenirProfilArtiste;
window.creerSortie = creerSortie;
window.obtenirSorties = obtenirSorties;
window.reinitialiserMotDePasse = reinitialiserMotDePasse;
window.deconnecterArtiste = deconnecterArtiste;
